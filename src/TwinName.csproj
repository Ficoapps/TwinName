<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net45</TargetFramework>
    <LangVersion>5</LangVersion>
    <ApplicationIcon>TwinName.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Ficoapps.png" LogicalName="TwinName.Ficoapps.png" />
    <Reference Include="Accessibility" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net45"
                      Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
